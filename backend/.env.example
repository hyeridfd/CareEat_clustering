SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
ADMIN_PASSWORD=admin123
JWT_SECRET=your-random-secret-key-here
FRONTEND_URL=https://your-app.vercel.app

# ── 돌봄 관리 ──
# 유형 모델: backend/models/<버전>/ (python -m care.train 으로 등록). 비우면 DB 활성 모델 사용
CARE_ACTIVE_MODEL=
# 솔루션 LLM: openai | anthropic | none(규칙 기반)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# 보호자 알림: dry_run(테스트, 실제 발송 없음) | sms(솔라피 문자) | live(솔라피 알림톡)
KAKAO_MODE=dry_run
KAKAO_PROVIDER=solapi
# 솔라피 (KAKAO_MODE=sms 또는 live 일 때 사용)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=
SOLAPI_TEMPLATE_ID=
# 솔라피에 등록한 발신번호 (문자 발송 시 필수)
SOLAPI_FROM=
# 보호자 리포트 링크 기준 주소 (프론트엔드 주소)
REPORT_BASE_URL=https://your-app.vercel.app
REPORT_TTL_DAYS=30
